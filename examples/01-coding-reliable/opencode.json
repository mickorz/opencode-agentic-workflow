{
  "plugins": [
    {
      "package": "@mickorz/opencode-agentic-workflow",
      "options": {
        "model": { "providerID": "glm", "id": "glm-5.3-flash" },
        "agent": "build",
        "concurrency": 3,
        "checkpoint": { "mode": "interactive" },
        "journalDir": ".agw/journal",
        "traceDir": ".agw/trace",
        "isolation": { "mode": "git-worktree" },
        "prices": {
          "glm/glm-5.3-flash": { "input": 0.15, "output": 0.5, "cacheRead": 0.03, "cacheWrite": 0 }
        }
      }
    }
  ]
}
